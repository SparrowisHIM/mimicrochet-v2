# The settings the site needs. Copy to .env.local for local development and fill in the values there;
# on Netlify they go in Project configuration > Environment variables (marked as secret).
# Never commit real values.

# Neon Postgres connection string (postgresql://...). Orders and their updates live here.
DATABASE_URL=

# Set to true on Netlify at go-live only: until then every Netlify build is hidden from search engines.
MIMI_LIVE=

# Mimi's studio. Make all four with `npm run studio:setup` (it asks for the password, hidden).
# The password itself is never stored, only this scrypt hash.
STUDIO_PASSWORD_HASH=
# Signs the "signed in" cookie; changing it signs every phone out.
SESSION_SECRET=
# Notifications on Mimi's phones (Web Push).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
